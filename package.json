{
  "name": "ai-foundation",
  "version": "0.0.0",
  "private": true,
  "description": "Маркетплейс плагінів Claude Code для комерційної розробки й самонавчання",
  "license": "MIT",
  "author": "Ivan Ivakhnenko",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GUSILLUS/ai-foundation.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "config": {
    "claudeCodeVersion": "2.1.321"
  },
  "scripts": {
    "validate": "node scripts/validate.ts",
    "test": "node scripts/test.ts",
    "sync": "node scripts/sync-shared.ts",
    "names:update": "node scripts/names-update.ts",
    "hooks:install": "git config core.hooksPath .githooks",
    "metrics:inventory": "node plugins/af-metrics/scripts/analyze-history.ts --inventory",
    "metrics:baseline": "node plugins/af-metrics/scripts/analyze-history.ts",
    "metrics:audit": "node plugins/af-metrics/scripts/plugin-audit.ts"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "7.0.2"
  }
}
